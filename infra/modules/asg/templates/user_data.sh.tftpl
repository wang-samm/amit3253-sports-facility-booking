#!/bin/bash
# Do not enable shell tracing here: this script handles database credentials.
set -euo pipefail

dnf update -y
dnf install -y httpd php php-mysqlnd php-cli jq unzip mariadb105

# Match the application's 5 MB image limit (PHP otherwise defaults to 2 MB).
cat <<'EOF' > /etc/php.d/assignment-uploads.ini
upload_max_filesize=6M
post_max_size=7M
EOF

# Pull DB connection details from Secrets Manager (assignment-db-credentials)
# using this instance's IAM role - no credentials are ever hardcoded here.
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${secret_arn}" \
  --region "${aws_region}" \
  --query SecretString --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)

cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$DB_HOST"
SetEnv DB_USER "$DB_USER"
SetEnv DB_PASS "$DB_PASS"
SetEnv DB_NAME "$DB_NAME"
SetEnv S3_BUCKET "${artifact_bucket}"
SetEnv AWS_REGION "${aws_region}"
EOF

mkdir -p /var/www/html

# Self-healing deploy: every new/replaced instance (scale-out, instance
# refresh, terraform apply after a destroy, etc.) pulls whatever was last
# shipped by the deploy.yml workflow, so the fleet never drifts back to the
# placeholder page after the first real deploy. Falls back to a placeholder
# only before any deploy has ever run.
if aws s3api head-object --bucket "${artifact_bucket}" --key "${artifact_key}" --region "${aws_region}" >/dev/null 2>&1; then
  aws s3 cp "s3://${artifact_bucket}/${artifact_key}" /tmp/assignment-app.zip --region "${aws_region}"
  rm -rf /var/www/html/*
  unzip -o /tmp/assignment-app.zip -d /var/www/html

  # Initialize the schema once. Every ASG instance may execute this block, so
  # the information_schema check makes it safe under concurrent scale-out.
  TABLE_EXISTS=$(mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -N -e \
    "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='users'")
  if [ "$TABLE_EXISTS" -eq 0 ]; then
    mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" < /var/www/html/schema.sql || true
  fi

  # Existing databases are not recreated during deployment. Add new fields
  # without changing any existing users or testimonials. Multiple instances
  # can boot together, so a second check handles another instance winning.
  column_exists() {
    local result
    result=$(mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -N -e \
      "SELECT COUNT(*) FROM information_schema.columns WHERE table_schema='$DB_NAME' AND table_name='$1' AND column_name='$2'")
    [ "$result" -gt 0 ]
  }
  ensure_column() {
    if ! column_exists "$1" "$2"; then
      mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -e \
        "ALTER TABLE $1 ADD COLUMN $2 $3" || column_exists "$1" "$2"
    fi
  }
  ensure_column users profile_image_url 'VARCHAR(500) NULL'
  ensure_column testimonials admin_reply 'TEXT NULL'
  ensure_column testimonials admin_reply_name 'VARCHAR(100) NULL'
  ensure_column testimonials admin_replied_at 'TIMESTAMP NULL'

  # Generate the demonstration password hash with the exact PHP runtime used
  # by this EC2 image. This avoids incompatibilities with a pre-generated hash
  # while keeping password verification inside PHP's password API.
  DEMO_HASH=$(php -r 'echo password_hash("password", PASSWORD_DEFAULT);')
  mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -e \
    "INSERT INTO users (name,email,password_hash,id_number,faculty,date_of_birth,is_admin)
       VALUES ('System Administrator','admin@example.com','$DEMO_HASH','ADMIN001','Faculty of Computing and Information Technology','2000-01-01',1)
       ON DUPLICATE KEY UPDATE password_hash=VALUES(password_hash),is_admin=1;
     INSERT INTO users (name,email,password_hash,id_number,faculty,date_of_birth,is_admin)
       VALUES ('Demo Student','student@example.com','$DEMO_HASH','24WMR00001','Faculty of Computing and Information Technology','2004-01-01',0)
       ON DUPLICATE KEY UPDATE password_hash=VALUES(password_hash),is_admin=0;"
else
  echo "<?php http_response_code(200); echo 'assignment-sports-booking: bootstrapped, waiting for first deploy.';" \
    > /var/www/html/index.php
  # Matches healthz.php's contract (no DB dependency) so the ALB target group
  # already sees this instance as healthy before the first real deploy.
  echo "<?php http_response_code(200); header('Content-Type: text/plain'); echo 'ok';" \
    > /var/www/html/healthz.php
fi

systemctl enable httpd
systemctl restart httpd
